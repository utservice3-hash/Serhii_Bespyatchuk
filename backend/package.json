{
  "name": "dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.readdirSync('src/db').filter(f=>f.endsWith('.sql')).forEach(f=>fs.copyFileSync('src/db/'+f,'dist/db/'+f))\" && node scripts/writeVersion.mjs",
    "test": "node --test \"dist/**/*.test.js\"",
    "reconcile": "node dist/scripts/reconcile.js",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:mapping": "tsx src/db/migrate.ts --with-kommo-mapping",
    "db:seed": "tsx src/db/seed.ts",
    "create-user": "tsx src/db/createUser.ts",
    "sync": "tsx src/jobs/syncKommo.ts",
    "backup": "tsx src/jobs/backupDb.ts",
    "sync:users": "tsx src/jobs/syncUsersOnly.ts",
    "backfill:client-keys": "tsx src/jobs/backfillClientKeys.ts",
    "bot": "tsx src/bot/index.ts",
    "test:prod": "TEST_SCOPE=prod node --import ./dist/testReadOnly.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./dist/testRunGate.js --test-reporter-destination=stdout --test \"dist/**/*.test.js\"",
    "test:ai": "TEST_SCOPE=prod TEST_AI=1 node --import ./dist/testReadOnly.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./dist/testRunGate.js --test-reporter-destination=stdout --test \"dist/**/*.test.js\"",
    "test:matrix": "TEST_SCOPE=prod TEST_MATRIX=1 node --import ./dist/testReadOnly.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./dist/testRunGate.js --test-reporter-destination=stdout --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "grammy": "^1.44.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.5",
    "pg-copy-streams": "^6.0.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/pg-copy-streams": "^1.2.5",
    "tsx": "^4.15.6",
    "typescript": "^5.5.2"
  }
}
