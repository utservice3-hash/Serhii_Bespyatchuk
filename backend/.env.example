PORT=4000
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard
JWT_SECRET=change-me

KOMMO_SUBDOMAIN=utsercice
KOMMO_BASE_URL=https://utsercice.kommo.com
KOMMO_API_TOKEN=

# Telegram bot for admin operations (adding users, manual sync, etc.)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to use the bot
TELEGRAM_ADMIN_IDS=

# Трекер часу — окрема наша система (свій сервер, своя база користувачів).
# Обидві порожні: пункт меню «Time tracker» не рендериться, ендпоінти віддають 503.
# Тобто дашборд піднімається й працює як раніше, доки їх не заповнять.
TRACKER_URL=
# Спільний із трекером ключ. Генерується на хості: openssl rand -hex 32
# Значення мусить бути ОДНАКОВЕ тут і в .env трекера, інакше кнопка дає 401.
TRACKER_SSO_KEY=
