# ─────────────────────────────────────────────────────────────────────────────
# UTS Dashboard — backend/.env (ЗРАЗОК)
#
# 🔒 ТУТ НЕМАЄ І НЕ БУДЕ ЖОДНОГО ЗНАЧЕННЯ. Тільки імена, призначення й межі.
#    Значення живуть у `backend/.env` на сервері; у git цей файл потрапляє через
#    виняток у `.gitignore` (`!.env.example`) — сам `.env` туди не потрапляє ніколи.
#
# ⚠️ ЯК ПЕРЕВІРИТИ, ЩО ЗМІННА ЗАДАНА, НЕ РОЗКРИВШИ ЇЇ:
#       [ -n "$DATABASE_URL" ] && echo так
#    І НІКОЛИ `echo ${DATABASE_URL:-...}` — така форма ДРУКУЄ значення. У нас уже
#    був витік `DATABASE_URL` ролі `kk_ro` саме через це.
#
# Повна таблиця «хто власник / як ротувати» — docs/TRANSFER_TO_ROMAN.md, розділ A.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ ОБОВʼЯЗКОВІ — без них процес НЕ СТАРТУЄ ═══
# `backend/src/config.ts` кличе на них `required()`, тобто кидає ще на імпорті
# конфігу. Їх рівно чотири; усе інше нижче — опційне з дефолтом або з деградацією.

# Postgres (Neon). Роль для застосунку — з правами на запис.
DATABASE_URL=
# Підпис JWT. Зміна ЗАВЖДИ розлогінює всіх — це не побічний ефект, а призначення.
JWT_SECRET=
# База Kommo CRM, напр. https://<піддомен>.kommo.com
KOMMO_BASE_URL=
# Довготривалий токен Kommo API.
KOMMO_API_TOKEN=

# ═══ МЕРЕЖА Й ЗАПУСК ═══
# Обидві інжектить панель adm.tools у Node.js-режимі. Локально не задавати.
# PORT: дефолт 4000. HOST: панель віддає ПОВНИЙ URL (http://127.x.x.x:3000) —
# config.ts сам дістає з нього hostname.
PORT=
HOST=

# ═══ ІНТЕГРАЦІЇ — порожньо означає «фіча спить», а не «помилка» ═══

# Telegram-бот адміністрування (grammy). Порожній токен → бот не піднімається.
TELEGRAM_BOT_TOKEN=
# Числові Telegram-id через кому; тільки вони мають доступ до бота.
TELEGRAM_ADMIN_IDS=

# Ringostat API (Налаштування → Інтеграції → Ringostat API).
# Порожньо → джоба дзвінків спить (це штатний стан, не поломка).
RINGOSTAT_AUTH_KEY=

# Lardi-Trans Extended API, RAW-токен без «Bearer».
# Порожньо → калькулятор ставок віддає зрозумілу відмову.
LARDI_API_TOKEN=
# Мова відповідей Lardi. Дефолт у коді: ru.
LARDIWEB_LANG=

# Таймтрекер — ОКРЕМА наша система зі своїм сервером і своєю таблицею людей.
# Обидва порожні → пункт меню не рендериться, ендпоінти віддають 503, дашборд
# працює як раніше. TRACKER_SSO_KEY мусить збігатися зі значенням у .env трекера,
# інакше кнопка входу отримує 401. Генерується: openssl rand -hex 32
TRACKER_URL=
TRACKER_SSO_KEY=

# ═══ ЗОВНІШНІ ДЖЕРЕЛА ДАНИХ ═══
# ⚠️ У всіх п’ятьох є ЗАШИТИЙ ДЕФОЛТ у `backend/src/config.ts`. Тобто якщо тут
#    порожньо — код піде за дефолтним посиланням, а НЕ вимкне джерело. Це важливо
#    при передачі: щоб перевести дашборд на СВОЇ таблиці, змінну треба задати явно.

# Дебіторка прямо з 1С (REST). Дефолт у коді — внутрішній хост за IP, без авторизації.
RECEIVABLES_1C_URL=
# Ліміти дебіторки — Google Sheet, експорт CSV.
RECEIVABLES_LIMITS_SHEET_URL=
# Бюджет реклами — Google Sheet, експорт CSV.
AD_BUDGET_SHEET_URL=
# «Реєстр» лідоген-бота — джерело правди для переданих заявок.
LEADGEN_REGISTRY_SHEET_URL=
# «Перший дотик» — лист того самого файлу, що й реєстр лідогену.
FIRST_TOUCH_SHEET_URL=

# ═══ AI-ОРАКУЛ (лише для `npm run test:ai`, платний) ═══
# Без ключа набір `test:ai` чесно пропускає свої перевірки з названою причиною.
ANTHROPIC_API_KEY=
# Модель оракула; дефолт — у `backend/src/ai/respond.ts`.
AI_MODEL=
# Базовий публічний URL, який оракул підставляє у відповіді.
PUBLIC_BASE_URL=

# ═══ NEON API — спостережність витрат компуту ═══
# `backend/src/utils/neonUsage.ts`. Немає ключа → хелпер повертає null і МОВЧИТЬ:
# спостережність не має права валити джобу, заради якої її додали.
# ⚠️ Межа, заміряна 04.08.2026: на плані Launch CU-години через API НЕ ДІСТАТИ
#    (consumption_history → 403, лічильники проєкту → нулі). Цифра є лише в консолі
#    Neon. Видавати ці нулі за «нічого не зʼїло» НЕ МОЖНА.
NEON_API_KEY=
NEON_ORG_ID=
NEON_PROJECT_ID=

# ═══ ПЕРШИЙ ЗАПУСК БАЗИ (`npm run seed`) ═══
# Читаються ТІЛЬКИ сидом (`backend/src/db/seed.ts`), у бойовому процесі не потрібні.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ═══ ЕКСПЛУАТАЦІЯ (не секрети; задаються на сервері або в оболонці) ═══
# Куди джоба бекапу кладе дампи (`backend/src/jobs/backupDb.ts`).
BACKUP_DIR=
# Підпис учасника в журналі замка чекауту. Ланцюг деплою ВІДМОВЛЯЄТЬСЯ стартувати
# з порожнім або дефолтним значенням — журнал є єдиним доказом переходу ходу.
UTS_ACTOR=
# Перевизначення шляхів для інструментів деплою. Мають робочі дефолти;
# задавати лише якщо дерево лежить не там, де очікує `tools/deploy.ts`.
UTS_BUILD_REPO=
UTS_DOC_ROOT=
UTS_REPO=
UTS_LOCK_DIR=
UTS_BACKUP_DIR=
UTS_NODE_BIN=
UTS_PROD_BRANCH=

# ═══ ТІЛЬКИ ДЛЯ ТЕСТІВ (у бойовому .env їх бути НЕ повинно) ═══
# TEST_SCOPE=prod вмикає перевірки проти живого API; разом із ним обовʼязковий
# preload `--import ./dist/testReadOnly.js`, який садить зʼєднання в роль
# `test_readonly`. Команда приймання — рівно `npm run test:prod`.
# 🔴 `TEST_SCOPE=prod npm test` — ЗАБОРОНЕНО: там немає preload, і набір пішов би
#    в бойову базу з ПОВНИМИ правами. Обхід закритий гейтом у `db/pool.ts`.
TEST_SCOPE=
API_BASE=
TEST_BEARER=
TEST_MATRIX=
TEST_AI=
TEST_MONTH=
TEST_CONV_MONTH=
# Одноразовий кластер Postgres для перевірки схеми з нуля.
TEST_SCRATCH_DB_URL=
TEST_SCRATCH_FORCE=
PG_BIN=
# Скільки разів повторити замір у скриптах-вимірювачах.
RUNS=
# Шляхи для Playwright у контейнері, де браузер лежить не за замовчуванням.
PLAYWRIGHT_CHROMIUM=
PLAYWRIGHT_MODULE=

# ─────────────────────────────────────────────────────────────────────────────
# 📋 ЧОМУ ЦЕЙ ПЕРЕЛІК ПОВНИЙ, І ЯК ЦЕ ПЕРЕВІРИТИ САМОМУ
#
# Імена зібрані ДВОМА предикатами, бо одного виявилось замало:
#     git grep -ohE 'process\.env(\.[A-Z0-9_]+|\["[A-Z0-9_]+"\])' -- backend/src
#     git grep -ohE '\benv\.[A-Z][A-Z0-9_]{2,}'                   -- backend/src
# Перший дає 45 імен, другий — 53. Різниця не косметична: другий знайшов
# `NEON_API_KEY`/`NEON_ORG_ID`/`NEON_PROJECT_ID` і `UTS_BUILD_REPO`/`UTS_DOC_ROOT`/
# `UTS_REPO`, які читаються через переданий обʼєкт `env`, а не через `process.env.X`.
# Тобто вужчий предикат мовчки пропустив би доступ до БАЗИ.
#
# 🚫 ПʼЯТЬ ІМЕН СВІДОМО НЕ МАЮТЬ РЯДКА ВИЩЕ — їх НЕ ЗАДАЄ ЛЮДИНА:
#   USER, LOGNAME            — дає операційна система;
#   PGOPTIONS                — виставляє preload `dist/testReadOnly.js`, саджаючи
#                              зʼєднання в роль `test_readonly`. Задавати руками
#                              не треба й небезпечно: це другий рубіж запобіжника;
#   NODE_OPTIONS,
#   NODE_TEST_CONTEXT        — виставляє сам Node / раннер тестів.
# Разом: 48 із рядком + 5 системних = 53. Числа мають зійтися; якщо не зійшлися —
# у коді зʼявилось нове імʼя, і цей файл відстав.
#
# ─────────────────────────────────────────────────────────────────────────────
# 🗑 ПРИБРАНО З ЦЬОГО ЗРАЗКА: `KOMMO_SUBDOMAIN`.
#    Воно стояло тут, але `git grep KOMMO_SUBDOMAIN` по всьому репозиторію дає
#    ОДНЕ входження — сам цей файл. Код його не читає ніде. Мертве імʼя в зразку
#    читається як живе налаштування, і новий власник витратив би час на пошук
#    того, що ні на що не впливає.
# ─────────────────────────────────────────────────────────────────────────────
