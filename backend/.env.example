PORT=4000
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard
JWT_SECRET=change-me

KOMMO_SUBDOMAIN=utsercice
KOMMO_BASE_URL=https://utsercice.kommo.com
KOMMO_API_TOKEN=

# Telegram bot for admin operations (adding users, manual sync, etc.)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to use the bot
TELEGRAM_ADMIN_IDS=

# Time tracker: a separate system of ours. Both empty means the nav item does not render
# and the endpoints answer 503, so the dashboard runs as before until these are filled in.
TRACKER_URL=
# Shared with the tracker. Generated on the host: openssl rand -hex 32
# Must be the same value here and in the tracker's .env, or the button gets a 401.
TRACKER_SSO_KEY=

# AI call analysis (ad leads). Both empty means the pipeline marks its queue "not_enabled" and
# makes no outbound request at all. ElevenLabs key: "Speech to Text" permission only.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
# Prices and monthly caps, USD. No defaults on purpose: empty means "not configured" and nothing is
# spent. Caps: $40 / $10 (owner decision 22.09.2026). Prices from vendor pricing pages on 28.09.2026:
# Scribe v2 0.22 per channel-hour; Gemini 3.8 Flash 0.75 in / 3.75 out per million tokens (doubles 01.01.2027).
CALL_AI_STT_USD_PER_HOUR=
CALL_AI_STT_MONTH_CAP_USD=
CALL_AI_LLM_USD_PER_MTOK_IN=
CALL_AI_LLM_USD_PER_MTOK_OUT=
CALL_AI_LLM_MONTH_CAP_USD=
