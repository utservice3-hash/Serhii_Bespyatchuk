# ---------------------------------------------------------------- Kommo (CRM)
# Subdomain only ("acme" for acme.kommo.com), or a full host.
KOMMO_SUBDOMAIN=
# Long-lived access token:
#   Kommo -> Settings -> Integrations -> your integration -> Keys and scopes
KOMMO_ACCESS_TOKEN=
# Which pipeline(s) hold the lead-gen deals. Comma-separated ids.
# Leave blank to take won deals from every pipeline.
# Run `python src/discover.py pipelines` to list ids and names.
KOMMO_PIPELINE_IDS=

# ------------------------------------------------------------ Ringostat (calls)
# Ringostat -> Integrations -> API -> Auth key
RINGOSTAT_AUTH_KEY=
RINGOSTAT_BASE_URL=https://api.ringostat.net

# ------------------------------------------------------------------- selection
MONTHS_BACK=3
CALLS_PER_DEAL=5
# Ignore calls shorter than this - rings and voicemail carry no conversation.
MIN_CALL_SECONDS=15

# --------------------------------------------------------------- transcription
# large-v3 is the most accurate for Ukrainian/Russian; use medium on a slow box.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
# Leave blank to autodetect per call (handles uk/ru code-switching).
WHISPER_LANGUAGE=
# auto | ch0_manager | ch0_client - see README "Verifying role mapping".
CHANNEL_ROLE_MODE=auto
# Optional: enables diarisation fallback for mono recordings.
HUGGINGFACE_TOKEN=

# ------------------------------------------------------------------- output
OUT_DIR=output
